# PostgreSQL connection (use real values only in an untracked .env file)
DB_USER=resqroute_app
DB_HOST=127.0.0.1
DB_NAME=resqroute
DB_PASSWORD=replace_with_a_local_development_password
DB_PORT=5432

# Use a random secret of at least 32 characters. Never commit a real value.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# API runtime
PORT=5000
NODE_ENV=development
# Comma-separated browser origins. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

# Local ML API
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=8000
